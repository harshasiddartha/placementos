# Supabase — Project Settings → API (URL + anon public key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optional: new-style publishable key (if not using anon key above)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Same Postgres as Supabase — Settings → Database → Connection pooling
# Use your project ref in the username: postgres.[PROJECT_REF]
# Prisma migrate uses DIRECT_URL; app/serverless uses DATABASE_URL with pgbouncer.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"
#
# Note: `npx prisma` loads `.env` by default (not `.env.local`). Put these in `.env`, or see:
# https://www.prisma.io/docs/orm/more/development-environment/environment-variables

# Site URL for auth redirects in production (optional; defaults to request origin)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin UI at /admin/onboarding — long random secret; required cookie value after /admin/login
# ADMIN_ACCESS_TOKEN=

# AI helpers on admin page (optional)
# GEMINI_API_KEY=          # or GOOGLE_API_KEY for @google/genai
# GROQ_API_KEY=
